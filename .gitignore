# ==============================================================================
# FastBee-Arduino - Git Ignore Rules
# ==============================================================================

# PlatformIO build directories
.pio/

# Python bytecode
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Build artifacts and distribution files
dist/
.archive-docs/

# IDE/Editor configurations
.vscode/
.idea/
.qoder/
.cursor/
.codex/
.codex-logs/
.superpowers/
*.swp
*.swo
*~

# Node.js dependencies
node_modules/

# Python logging and configuration
*.log
Logs/
logs/

# Build artifacts (all platforms)
build_log*.txt
build_only_log.txt
deploy_log.txt
upload_log.txt
upload.log
compile_commands.json

# Binary dumps and test reports
partitions_dump.bin

# Test reports and coverage
test/browser/test-results/
test/browser/reports/
test/browser/test-regression-output.txt
test/reports/
playwright-report/
tmp/test-results/
/test-results/
/artifacts/
body*.txt
docs/soak-report-*.html
docs/soak-summary-*.json
docs/test-report.md

# Device test output and local credentials
*.cookies
*-cookie.txt
*-cookies.txt
*-headers.txt
*-metrics.json
*-mqtt-status.json
/.device-config-backups/
docs/.device-config-backups/

# ESP-IDF sdkconfig generated files
sdkconfig
sdkconfig.old
sdkconfig.*.local

# ESP-IDF component manager output (restorable via dependencies.lock; E1 2026-10-15 停止跟踪)
managed_components/

# Web frontend: source lives in web-src/, build artifacts are generated per-profile (lite/standard/full).
# Run `node scripts/gzip-www.js` or use `deploy.ps1` (auto-generates if missing).
# All files in data/www are dynamically generated except assets directory
data/www/
!data/www/assets/
!data/www/assets/**

# Temporary files
/tmp/

# Workspace snapshots and isolated build directories (repo-root only, never committed)
/fastbee-*/
temp-web-update.zip
tmp-file-list.csv
*.tmp
*.temp
device_*.html
# Temporary debugging documentation
TEMP-*.md
SOLUTION.md
debug-*.md

# Backup files
*.backup*
*.bak*
platformio.ini.backup*

# OS/system files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# Windows file locks
$RECYCLE.BIN/
