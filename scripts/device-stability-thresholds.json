{
  "version": 2,
  "description": "Stability guards for the unified firmware; PSRAM hardware has additional memory requirements.",
  "presets": {
    "release": {
      "description": "Conservative release gate for long-running device validation.",
      "thresholds": {
        "maxFailureRatePercent": 0,
        "maxP95LatencyMs": 7000,
        "maxConsecutiveFailures": 1,
        "maxEndpointFailureRatePercent": 0,
        "maxUptimeResetCount": 0,
        "minHeapFreeBytes": 25600,
        "minHeapMaxAllocBytes": 10000,
        "maxHeapFreeDropBytes": 40000,
        "maxHeapMaxAllocDropBytes": 24000,
        "minPsramFreeBytes": 0,
        "maxPsramFreeDropBytes": 0
      },
      "psramThresholds": {
        "maxFailureRatePercent": 0,
        "maxP95LatencyMs": 7000,
        "maxConsecutiveFailures": 1,
        "maxEndpointFailureRatePercent": 0,
        "maxUptimeResetCount": 0,
        "minHeapFreeBytes": 25600,
        "minHeapMaxAllocBytes": 12000,
        "maxHeapFreeDropBytes": 40000,
        "maxHeapMaxAllocDropBytes": 24000,
        "minPsramFreeBytes": 262144,
        "maxPsramFreeDropBytes": 524288
      }
    }
  }
}
