// @types@
inline void convertToJson(const String& value,JsonVariant destination) { destination.set(value.c_str()); }
inline size_t serializeJson(const JsonDocument& doc,String& output) {
    std::string text;const size_t size=ArduinoJson::serializeJson(doc,text);output=text;return size;
}
inline DeserializationError deserializeJson(JsonDocument& doc,const String& text) {
    return ArduinoJson::deserializeJson(doc,text.c_str(),text.length());
}
struct AsyncWebParameter {
    String key,text; bool post=true,file=false;
    const String& name() const { return key; }
    const String& value() const { return text; }
    bool isPost() const { return post; }
    bool isFile() const { return file; }
};
struct AsyncWebServerRequest {
    std::vector<AsyncWebParameter> fields;
    int status=0; String error; std::string body;
    ~AsyncWebServerRequest() {
        std::printf("HTTP %d %zu %zu\n", status, error.length(), body.size());
        std::fwrite(error.c_str(), 1, error.length(), stdout);
        std::fputc('\n', stdout);
        std::fwrite(body.data(), 1, body.size(), stdout);
        std::fputc('\n', stdout);
    }
    void add(const char* key,const String& text,bool post=true) { fields.push_back({key,text,post,false}); }
    void set(const char* key,const String& text) {
        for(auto& field:fields) if(field.key==key) { field.text=text;return; }
        add(key,text);
    }
    size_t params() const { return fields.size(); }
    const AsyncWebParameter* getParam(size_t i) const { return i<fields.size()?&fields[i]:nullptr; }
    const AsyncWebParameter* getParam(const char* key,bool post) const {
        for(const auto& field:fields) if(field.key==key && field.post==post) return &field;
        return nullptr;
    }
    bool hasParam(const char* key,bool post) const { return getParam(key,post)!=nullptr; }
};
struct ModbusSubDevice {
    uint8_t slaveAddress=7,channelCount=8,baudRateMode=0;
    uint16_t baudRateReg=0x33;
    bool ncMode=false;
    char sensorId[32]="relay";
};
static unsigned leased=0, reports=0;
static bool pressure=false;
static uint8_t reportIndex=0;
static uint16_t reportChannel=0;
static String reportValue,reportSensor;
struct FakeMqtt {
    bool connected=true;
    unsigned publishes=0;
    String payload;
    bool getIsConnected() const { return connected; }
    void publishReportData(const String& value) { assert(leased);++publishes;payload=value; }
} mqtt;
namespace FastBee {
struct MqttClientLease {
    FakeMqtt* client=nullptr;
    MqttClientLease(FakeMqtt* value=nullptr):client(value) {}
    explicit operator bool() const { return client!=nullptr; }
    FakeMqtt* operator->() const { return client; }
};
