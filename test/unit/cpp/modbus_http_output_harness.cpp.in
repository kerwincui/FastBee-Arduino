struct ActionExecResult {
    FastBee::ActionReportIdentity reportIdentity=FastBee::ActionReportIdentity::Invalid;
    uint16_t reportIdBytes=0;
    String targetPeriphId,dataField,actualValue,remark;
    bool success=false;
