// Extracted entire production P1 HTTP reader/writer, real config and ArduinoJson.
#include <Arduino.h>
#include <ArduinoJson.h>
#include "core/PeripheralConfig.h"
#include "core/RtcBootSeedConfig.h"
#include <cassert>
#include <map>
#include <string>
inline void convertToJson(const String& value, JsonVariant out) { out.set(std::string(value)); }
namespace FastBee {
void serializeSensorConfig(JsonObject, const PeripheralConfig&) { assert(false); }
bool parseSensorConfig(JsonObjectConst, PeripheralConfig&, String&) { assert(false); return false; }
bool validateSensorConfig(const PeripheralConfig&, String&) { assert(false); return false; }
}
struct AsyncWebServerRequest {
    std::map<std::string, String> fields;
    bool hasParam(const char* key, bool = false) const { return fields.count(key) != 0; }
};
struct WebHandlerContext {
    String getParamValue(AsyncWebServerRequest* request, const char* key, const String& fallback) {
        const auto found = request->fields.find(key);
        return found == request->fields.end() ? fallback : found->second;
    }
    int getParamInt(AsyncWebServerRequest* request, const char* key, int fallback) {
        return request->hasParam(key) ? static_cast<int>(getParamValue(request, key, "").toInt()) : fallback;
    }
    bool getParamBool(AsyncWebServerRequest* request, const char* key, bool fallback) {
        return request->hasParam(key) ? getParamValue(request, key, "") == "true" : fallback;
    }
};
@PRODUCTION_P1_FUNCTIONS@
static void assertRoundTrip(const PeripheralConfig& config, bool expected, int offset) {
    JsonDocument doc; addP1PeripheralParams(doc.to<JsonObject>(), config);
    assert(doc["bootSeed"].is<bool>() && doc["bootSeed"].as<bool>() == expected);
    if (offset == INT16_MIN) assert(doc["utcOffsetMinutes"].isUnbound());
    else assert(doc["utcOffsetMinutes"].is<int>() && doc["utcOffsetMinutes"].as<int>() == offset);
    bool enabled = false; int16_t parsedOffset = INT16_MIN; String error;
    assert(FastBee::parseRtcBootSeedConfig(doc.as<JsonObjectConst>(), enabled, parsedOffset, error));
    assert(enabled == expected && parsedOffset == offset);
}
int main() {
    PeripheralConfig config; config.type = PeripheralType::DS1302_RTC;
    initializeDs1302Defaults(config);
    WebHandlerContext ctx; AsyncWebServerRequest request; String error;
    assert(applyP1PeripheralParams(&ctx, &request, config, true, error));
    assertRoundTrip(config, false, INT16_MIN);
    request.fields["bootSeed"] = "true";
    assert(!applyP1PeripheralParams(&ctx, &request, config, true, error));
    for (const char* invalid : {"", "null", "1.0", "TRUE", " true ", "yes", "2"}) {
        request.fields["bootSeed"] = invalid; request.fields["utcOffsetMinutes"] = "0";
        assert(!applyP1PeripheralParams(&ctx, &request, config, true, error));
    }
    request.fields["bootSeed"] = "1";
    for (const char* invalid : {"", "841", "-841", "32768", "NaN", "0.5", "1e2", " 0", "0 ", "0x0", "-", "+8", "false"}) {
        request.fields["utcOffsetMinutes"] = invalid;
        assert(!applyP1PeripheralParams(&ctx, &request, config, true, error));
    }
    for (const char* offset : {"-840", "-1", "0", "480", "840"}) {
        request.fields["utcOffsetMinutes"] = offset;
        assert(applyP1PeripheralParams(&ctx, &request, config, true, error));
        assertRoundTrip(config, true, std::stoi(offset));
    }
    // Missing update fields preserve an explicit reviewed offset, never opt in.
    request.fields.clear();
    assert(applyP1PeripheralParams(&ctx, &request, config, false, error));
    assertRoundTrip(config, true, 840);
    request.fields["bootSeed"] = "0"; request.fields["utcOffsetMinutes"] = "";
    assert(applyP1PeripheralParams(&ctx, &request, config, false, error));
    assertRoundTrip(config, false, INT16_MIN);
    // Parsing is atomic for the two new fields even when an offset fails.
    request.fields["bootSeed"] = "1"; request.fields["utcOffsetMinutes"] = "900";
    assert(!applyP1PeripheralParams(&ctx, &request, config, false, error));
    assertRoundTrip(config, false, INT16_MIN);
}
