struct MotionScriptCommand { String strParam = "servo", subAction = "PWM"; int intParam = 4096; };
static bool scriptServo(PeripheralManager& pm, const Context* control, Result* controlResult) {
    MotionScriptCommand cmd;
    PeripheralConfig nativeTarget;
    do {
