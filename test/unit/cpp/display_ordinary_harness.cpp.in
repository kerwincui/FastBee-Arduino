#define LOG_INFOF(...) ((void)0)
#define LOG_INFO(...) ((void)0)
constexpr int OUTPUT=1, INPUT=0, INPUT_PULLUP=2;
using SemaphoreHandle_t = int*;
static int driverMutex=1;
static bool pmBusy=false, driverBusy=false, driverHeld=false, featureEnabled=true, uartCurrent=true;
static unsigned pmDepth=0, ioCalls=0, ackReads=0, nackAt=0;
static int64_t clockUs=1000000;
static int modes[64]{}, levels[64]{};
static std::vector<int> highBits;
static std::vector<uint8_t> bytesSent;
SemaphoreHandle_t xSemaphoreCreateMutex() { return &driverMutex; }
void vSemaphoreDelete(SemaphoreHandle_t) {}
struct RecursiveMutexGuard {
    bool held;
    explicit RecursiveMutexGuard(int, int=-1) : held(!pmBusy) { if(held) ++pmDepth; }
    ~RecursiveMutexGuard() { if(held) --pmDepth; }
    bool isLocked() const { return held; }
};
struct MutexGuard {
    bool held;
    explicit MutexGuard(SemaphoreHandle_t mutex, int=0) : held(mutex && !driverBusy && !driverHeld) {
        if(held) driverHeld=true;
    }
    ~MutexGuard() { if(held) driverHeld=false; }
    bool isLocked() const { return held; }
};
unsigned long millis() { return static_cast<unsigned long>(clockUs/1000); }
int64_t esp_timer_get_time() { return clockUs; }
void delay(unsigned long ms) { assert(pmDepth && driverHeld); clockUs += ms*1000; }
void delayMicroseconds(unsigned int us) { assert(pmDepth && driverHeld); clockUs += us; }
void pinMode(uint8_t pin,int mode) { assert(pmDepth && driverHeld); ++ioCalls; modes[pin]=mode; }
void digitalWrite(uint8_t pin,int level) {
    assert(pmDepth && driverHeld); ++ioCalls; levels[pin]=level;
    if(pin==4 && level==HIGH && modes[5]==OUTPUT) highBits.push_back(levels[5]);
}
int digitalRead(uint8_t pin) {
    assert(pmDepth && driverHeld && pin==5); ++ioCalls; ++ackReads;
    assert(highBits.size()>=8); uint8_t byte=0;
    for(unsigned i=0;i<8;++i) byte |= static_cast<uint8_t>(highBits[highBits.size()-8+i] << i);
    bytesSent.push_back(byte);
    return nackAt==ackReads ? HIGH : LOW;
}
namespace FastBee {
struct RuntimeFeatureManager {
    static RuntimeFeatureManager& instance() { static RuntimeFeatureManager f; return f; }
    bool shouldEnable(const char*) const { return featureEnabled; }
};
}
