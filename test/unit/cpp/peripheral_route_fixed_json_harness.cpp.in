static std::string activeCase;
#define CHECK(expression) do { if (!(expression)) { \
    std::cerr << activeCase << ':' << __LINE__ << ": " << #expression << '\n'; \
    std::exit(86); } } while (0)

struct TraceAllocator : ArduinoJson::Allocator {
    static constexpr size_t never = std::numeric_limits<size_t>::max();
    std::map<void*, size_t> blocks;
    std::vector<std::string> events;
    size_t growthCalls = 0, failures = 0, failAt = never;
    bool transient = false;
    bool reject(const char* kind, size_t bytes) {
        const size_t call = growthCalls++;
        const bool rejected = transient ? call == failAt : call >= failAt;
        events.push_back(std::string(kind) + std::to_string(bytes) + (rejected ? ":fail" : ":ok"));
        failures += rejected ? 1 : 0;
        return rejected;
    }
    void* allocate(size_t bytes) override {
        if (reject("allocate:", bytes)) return nullptr;
        void* result = std::malloc(bytes); CHECK(result != nullptr);
        blocks[result] = bytes; return result;
    }
    void deallocate(void* pointer) override {
        if (!pointer) return;
        auto found = blocks.find(pointer); CHECK(found != blocks.end());
        events.push_back("free:" + std::to_string(found->second));
        blocks.erase(found); std::free(pointer);
    }
    void* reallocate(void* pointer, size_t bytes) override {
        auto found = blocks.find(pointer);
        if (pointer) CHECK(found != blocks.end());
        // AJ shrinkToFit retains a valid allocation. Do not inject a shrinking
        // realloc failure; inject only allocate/growing-reallocate points.
        if (pointer && bytes <= found->second) {
            events.push_back("shrink:" + std::to_string(bytes)); return pointer;
        }
        if (reject("reallocate:", bytes)) return nullptr;
        if (pointer) blocks.erase(found);
        void* result = std::realloc(pointer, bytes); CHECK(result != nullptr);
        blocks[result] = bytes; return result;
    }
};

struct Shape : ArduinoJson::detail::JsonVariantVisitor<std::string> {
    std::string visit(JsonObjectConst object) {
        std::string result = "object{";
        for (JsonPairConst field : object) {
            result += std::string(field.key().c_str(), field.key().size());
            result += field.key().isStatic() ? ":linked-key=" : ":copied-key=";
            result += ArduinoJson::detail::accept(field.value(), *this) + ";";
        }
        return result + "}";
    }
    std::string visit(JsonArrayConst array) {
        std::string result = "array[";
        for (JsonVariantConst value : array) result += ArduinoJson::detail::accept(value, *this) + ";";
        return result + "]";
    }
    std::string visit(JsonString value) { return value.isStatic() ? "linked-string" : "owned-string"; }
    template<class T> std::string visit(const T&) {
        if constexpr (std::is_same<T, bool>::value) return "bool";
        if constexpr (std::is_same<T, std::nullptr_t>::value) return "null";
        if constexpr (std::is_floating_point<T>::value) return "float" + std::to_string(sizeof(T));
        if constexpr (std::is_integral<T>::value) return std::is_signed<T>::value ? "signed" : "unsigned";
        CHECK(false); return "unsupported";
    }
};

struct Snapshot {
    std::string bytes, shape;
    bool overflowed = false;
    bool operator==(const Snapshot& other) const {
        return bytes == other.bytes && shape == other.shape && overflowed == other.overflowed;
    }
};
static Snapshot capture(const JsonDocument& document) {
    Snapshot result;
    serializeJson(document, result.bytes);
    Shape shape; result.shape = ArduinoJson::detail::accept(document.as<JsonVariantConst>(), shape);
    result.overflowed = document.overflowed();
    return result;
}
static TraceAllocator* activeAllocator = nullptr;
static Snapshot lastDocument;
static unsigned documentsCreated = 0;
struct TrackedDocument : JsonDocument {
    TrackedDocument() : JsonDocument(activeAllocator) { CHECK(activeAllocator); ++documentsCreated; }
    ~TrackedDocument() { lastDocument = capture(*this); }
};

static std::vector<std::string> reads;
static unsigned scenario = 0;
static bool returnValue = false;
static std::vector<Snapshot> observations;
static void observe(const JsonDocument& doc) { observations.push_back(capture(doc)); }
struct FakeRequest { int status = 0; unsigned sends = 0; std::string body; };
static FakeRequest request;
struct FakeContext {
    void sendError(FakeRequest* req, int code, const char* message) {
        reads.push_back("sendError"); req->status = code; ++req->sends; req->body = message;
    }
};
static FakeContext context;
static FakeContext* ctx = &context;
static bool deferJsonSend = false;
static FastBee::JsonDocumentResponse* pendingJsonResponse = nullptr;
static std::vector<std::pair<std::string, std::string>> deferredExpectedText;
namespace HandlerUtils {
void sendJsonStream(FakeRequest* req, JsonDocument& doc) {
    reads.push_back("send"); observe(doc); req->status = 200; ++req->sends;
    if (deferJsonSend) {
        CHECK(pendingJsonResponse == nullptr);
        for (const auto& expected : deferredExpectedText) {
            const JsonString actual = doc["data"]["params"][expected.first.c_str()].as<JsonString>();
            CHECK(!actual.isStatic());
            CHECK(actual.size() == expected.second.size());
            CHECK(std::strcmp(actual.c_str(), expected.second.c_str()) == 0);
        }
        pendingJsonResponse = new FastBee::JsonDocumentResponse(std::move(doc));
    } else {
        serializeJson(doc, req->body);
    }
}
}
class PeripheralManager {
public:
    std::map<std::string, PeripheralConfig> entries;
    PeripheralRuntimeState state;
    EncoderReading encoder;
    bool runtimeAvailable = true, encoderAvailable = true, pcaAvailable = true;
    int getMutex() { reads.push_back("mutex"); return 1; }
    uint64_t getConfigurationReviewVersion() { reads.push_back("version"); return 0x100000003ULL; }
    bool getPeripheralSnapshot(const String& id, PeripheralConfig& out) {
        reads.push_back("config:" + std::string(id.c_str()));
        auto it = entries.find(id.c_str());
        if (it == entries.end()) return false;
        out = it->second; return true;
    }
    template<class Visitor> void forEachPeripheral(Visitor visit) {
        for (const auto& item : entries) visit(item.second);
    }
    bool getRuntimeStateSnapshot(const String&, PeripheralRuntimeState& out) {
        reads.push_back("runtime"); if (!runtimeAvailable) return false; out = state; return true;
    }
    bool getEncoderReading(const String&, EncoderReading& out) {
        reads.push_back("encoder"); if (!encoderAvailable) return false; out = encoder; return true;
    }
    bool getPca9685Status(const String&, JsonObject output) {
        reads.push_back("pca-status");
        // Unchanged delegate seam exercises allocation and RHS-before-LHS
        // order. The actual PCA serializer is validated by its owning fixture.
        output["fixtureStatus"] = String("a copied PCA status payload");
        return pcaAvailable;
    }
};
