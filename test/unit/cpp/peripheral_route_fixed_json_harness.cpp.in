class SensorDriverCache {
public:
    static SensorDriverCache& instance() { static SensorDriverCache value; return value; }
    bool getSnapshot(const String&, SensorReading& out, bool& stale, String& error) {
        reads.push_back("sensor-snapshot"); stale = (scenario & 2U) != 0;
        error = (scenario & 4U) ? "sensor history" : "";
        out.channelCount = (scenario & 8U) ? 4 : 2; out.timestamp = 0xfffffffeUL;
        out.channelMetadata = (scenario & 64U) != 0;
        for (unsigned i = 0; i < 4; ++i) {
            out.channelTimestamps[i] = 0xfffffffeUL - i;
            out.channelErrors[i] = static_cast<SensorChannelError>(i);
        }
        out.values[0] = -1.25f; out.values[1] = 125.5f; out.values[2] = NAN; out.values[3] = INFINITY;
        return (scenario & 1U) != 0;
    }
};
