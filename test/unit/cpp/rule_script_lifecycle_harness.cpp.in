#include <atomic>
#include <cassert>
#include <cstdint>
#include <functional>
#include <map>
#include <mutex>
#include <string>
#include <thread>
#include <vector>
#define ARDUINOJSON_ENABLE_ARDUINO_STRING 0
#include "core/CheckedReportTemplate.h"
#include "core/FeatureInstanceRegistry.h"
#include "core/RuleScriptLifetime.h"
#define FASTBEE_MEMORY_BUDGET_H
namespace FastBee {
struct MemoryBudget {
    static uint32_t dram8Free() { return 1024 * 1024; }
    static uint32_t dram8Largest() { return 1024 * 1024; }
};
}
#include "core/RuleScriptResources.h"

unsigned operations = 0, failAt = 0;
class String {
    std::string text;
public:
    String() = default;
    String(const char* value) : text(value ? value : "") {}
    String(std::string value) : text(std::move(value)) {}
    size_t length() const { return text.size(); }
    const char* c_str() const { return text.c_str(); }
    bool isEmpty() const { return text.empty(); }
    bool reserve(unsigned int n) { if (++operations == failAt) return false; text.reserve(n); return true; }
    bool concat(const char* value, unsigned int n) { if (++operations == failAt) return false; text.append(value, n); return true; }
};
namespace FastBee {
struct RuntimeFeatureManager {
    bool userEnabled = true, admitted = true;
    static RuntimeFeatureManager& instance() { static RuntimeFeatureManager manager; return manager; }
    bool shouldEnable(const char*) const { return userEnabled && admitted; }
    bool isUserEnabled(const char*) const { return userEnabled; }
};
}
struct Semaphore { std::mutex mutex; std::atomic<unsigned> holders{0}; };
using SemaphoreHandle_t = Semaphore*;
static std::atomic<unsigned> allocations{0}, deletions{0}, loads{0};
static bool failMutex = false, loadOkay = true;
static std::function<void()> duringLoad;
SemaphoreHandle_t xSemaphoreCreateMutex() {
    if (failMutex) return nullptr;
    ++allocations;
    return new Semaphore;
}
void vSemaphoreDelete(SemaphoreHandle_t value) {
    assert(value && value->holders == 0);
    ++deletions;
    delete value;
}
class MutexGuard {
    SemaphoreHandle_t value;
    bool held;
public:
    explicit MutexGuard(SemaphoreHandle_t semaphore, unsigned = 0)
        : value(semaphore), held(value && value->mutex.try_lock()) {
        if (held) ++value->holders;
    }
    ~MutexGuard() { if (held) { --value->holders; value->mutex.unlock(); } }
    bool isLocked() const { return held; }
};
uint32_t millis() { return 17; }
struct RuleScript {
    bool enabled = true;
    unsigned triggerType = 1, protocolType = 0;
    uint32_t lastTriggerTime = 0, triggerCount = 0;
    String scriptContent;
};
class TestRuleMap : public FastBee::RuleScriptMap<int, RuleScript> {
public:
    RuleScript& operator[](int id) {
        auto found = find(id);
        if (found != end()) return found->second;
        if (empty()) { clear(); assert(reserve(1)); }
        int key = id;
        auto inserted = emplace(std::move(key), RuleScript());
        assert(inserted.second); return inserted.first->second;
    }
};
class RuleScriptManager {
public:
    SemaphoreHandle_t _mutex = nullptr;
    TestRuleMap _rules;
    mutable FastBee::RuleScriptLifetime _lifetime;
    std::atomic<bool> _startFailed{false};
    @ACCESS_GUARD@
    bool initialize();
    bool stop();
    void cleanupIfIdle();
    FastBee::FeatureInstanceSnapshot observeFeatureInstance() const;
    bool tryApplyReportTransform(uint8_t, const String&, String&, size_t);
    bool loadConfigurationLocked() {
        ++loads;
        assert(_mutex && _mutex->holders == 1);
        _rules[0].scriptContent = "${x}";
        if (duringLoad) duringLoad();
        return loadOkay;
    }
};
@OBSERVE@
@INITIALIZE@
@CLEANUP@
@STOP@
@REPORT@

std::string bytes(const String& value) { return std::string(value.c_str(), value.length()); }
int main(int argc, char** argv) {
    assert(argc == 2);
    const std::string mode = argv[1];
    RuleScriptManager manager;
    auto& features = FastBee::RuntimeFeatureManager::instance();
    using FastBee::FeatureInstanceState;
    using FastBee::FeatureInstanceReason;
    if (mode == "disabled_raw") {
        features.userEnabled = false;
        String output;
        for (const char* input : {"raw", "{\"x\":4}", "[1,2]", "0"}) {
            assert(manager.tryApplyReportTransform(0, input, output, 512));
            assert(bytes(output) == input);
        }
        assert(!manager.tryApplyReportTransform(0, String(std::string(513, 'x')), output, 512));
        assert(!manager.tryApplyReportTransform(0, String(std::string("x\0y", 3)), output, 512));
        operations = 0; failAt = 1;
        assert(!manager.tryApplyReportTransform(0, "raw", output, 512));
        assert(allocations == 0 && loads == 0 && manager._mutex == nullptr);
    } else if (mode == "initialize_once") {
        assert(manager.initialize());
        for (unsigned i = 0; i < 100; ++i) assert(manager.initialize());
        assert(loads == 1 && allocations == 1);
        String output;
        assert(manager.tryApplyReportTransform(0, "{\"x\":4}", output, 512) && bytes(output) == "4");
        assert(manager.stop() && deletions == 1 && manager._rules.empty() && !manager._mutex);
        assert(manager.stop() && deletions == 1);
    } else if (mode == "retire_with_reader") {
        assert(manager.initialize());
        {
            RuleScriptManager::AccessGuard access(manager);
            assert(access.admitted());
            MutexGuard lock(access.mutex());
            assert(lock.isLocked());
            assert(!manager.stop());
            assert(manager.observeFeatureInstance().state == FeatureInstanceState::CleanupPending);
            assert(deletions == 0 && !manager._rules.empty());
            RuleScriptManager::AccessGuard denied(manager);
            assert(!denied.admitted() && denied.mutex() == nullptr);
            assert(!manager.initialize());
        }
        assert(deletions == 1 && manager._rules.empty() && !manager._mutex);
        assert(manager.observeFeatureInstance().state == FeatureInstanceState::Stopped);
        assert(manager.initialize() && loads == 2);
        assert(manager.stop() && allocations == deletions);
    } else if (mode == "cancel_initialization") {
        duringLoad = [&] { assert(!manager.stop()); assert(deletions == 0); };
        assert(!manager.initialize());
        assert(manager._lifetime.idle() && !manager._mutex && manager._rules.empty());
        assert(allocations == deletions && features.userEnabled);
        duringLoad = nullptr;
        assert(manager.initialize());
        assert(manager.stop());
    } else if (mode == "failure_recovery") {
        failMutex = true;
        assert(!manager.initialize() && !manager._mutex && loads == 0);
        assert(manager.observeFeatureInstance().reason == FeatureInstanceReason::BackendUnavailable);
        failMutex = false; loadOkay = false;
        assert(!manager.initialize() && manager._rules.empty() && !manager._mutex);
        assert(features.userEnabled && allocations == deletions);
        String output;
        assert(!manager.tryApplyReportTransform(0, "raw", output, 512));
        loadOkay = true;
        assert(manager.initialize());
        assert(manager.observeFeatureInstance().state == FeatureInstanceState::Initialized);
        assert(manager.stop());
    } else if (mode == "policy_denied") {
        features.admitted = false;
        assert(!manager.initialize());
        String output;
        assert(!manager.tryApplyReportTransform(0, "raw", output, 512));
        assert(features.userEnabled && loads == 0 && allocations == 0);
    } else if (mode == "disabled_loaded_raw") {
        assert(manager.initialize());
        features.userEnabled = false;
        String output;
        assert(manager.tryApplyReportTransform(0, "{\"x\":4}", output, 512));
        assert(bytes(output) == "{\"x\":4}" && manager._rules[0].triggerCount == 0);
        assert(manager.stop());
    } else if (mode == "concurrent_retirement") {
        for (unsigned cycle = 0; cycle < 100; ++cycle) {
            assert(manager.initialize());
            std::atomic<unsigned> entered{0};
            std::atomic<bool> release{false};
            std::vector<std::thread> readers;
            for (unsigned i = 0; i < 8; ++i) readers.emplace_back([&] {
                RuleScriptManager::AccessGuard access(manager);
                assert(access.admitted() && access.mutex());
                ++entered;
                while (!release.load()) std::this_thread::yield();
                // Still a valid mutex and map after admission has been closed.
                assert(access.mutex() && !manager._rules.empty());
            });
            while (entered != 8) std::this_thread::yield();
            const auto before = deletions.load();
            assert(!manager.stop() && deletions == before);
            assert(!manager.initialize());
            RuleScriptManager::AccessGuard denied(manager);
            assert(!denied.admitted());
            release = true;
            for (auto& thread : readers) thread.join();
            assert(deletions == before + 1 && manager._lifetime.idle() && manager._rules.empty());
        }
        assert(allocations == deletions);
    } else if (mode == "concurrent_initialization") {
        for (unsigned cycle = 0; cycle < 100; ++cycle) {
            std::vector<std::thread> starters;
            for (unsigned i = 0; i < 8; ++i) starters.emplace_back([&] { manager.initialize(); });
            for (auto& thread : starters) thread.join();
            assert(manager._lifetime.running() && allocations == cycle + 1 && loads == cycle + 1);
            assert(manager.stop());
        }
        assert(allocations == deletions);
    } else assert(false);
}
