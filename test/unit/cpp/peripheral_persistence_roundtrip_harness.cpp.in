struct TraceAllocator : ArduinoJson::Allocator {
    static constexpr size_t never = std::numeric_limits<size_t>::max();
    std::map<void*, size_t> blocks;
    std::vector<std::string> events;
    size_t growthCalls = 0, failures = 0, failAt = never;
    bool transient = false;
    void configure(size_t point = never, bool oneFailure = false) {
        CHECK(blocks.empty());
        events.clear(); growthCalls = failures = 0; failAt = point; transient = oneFailure;
    }
    bool reject(const char* kind, size_t bytes) {
        const size_t call = growthCalls++;
        const bool fail = transient ? call == failAt : call >= failAt;
        events.push_back(std::string(kind) + std::to_string(bytes) + (fail ? ":fail" : ":ok"));
        failures += fail ? 1 : 0;
        return fail;
    }
    void* allocate(size_t bytes) override {
        if (reject("allocate:", bytes)) return nullptr;
        void* result = std::malloc(bytes);
        CHECK(result != nullptr);
        blocks[result] = bytes;
        return result;
    }
    void deallocate(void* pointer) override {
        if (!pointer) return;
        auto found = blocks.find(pointer); CHECK(found != blocks.end());
        events.push_back("free:" + std::to_string(found->second));
        blocks.erase(found); std::free(pointer);
    }
    void* reallocate(void* pointer, size_t bytes) override {
        auto found = blocks.find(pointer);
        if (pointer) CHECK(found != blocks.end());
        // ArduinoJson shrinkToFit assumes shrinking realloc succeeds. Retain
        // valid physical storage instead of injecting an invalid shrink fault.
        if (pointer && bytes <= found->second) {
            events.push_back("shrink:" + std::to_string(bytes));
            return pointer;
        }
        if (reject("reallocate:", bytes)) return nullptr;
        if (pointer) blocks.erase(found);
        void* result = std::realloc(pointer, bytes);
        CHECK(result != nullptr);
        blocks[result] = bytes;
        return result;
    }
};

struct Shape : ArduinoJson::detail::JsonVariantVisitor<std::string> {
    std::string visit(JsonObjectConst object) {
        std::string result = "object{";
        for (JsonPairConst field : object) {
            result += std::string(field.key().c_str(), field.key().size());
            result += field.key().isStatic() ? ":linked-key=" : ":copied-key=";
            result += ArduinoJson::detail::accept(field.value(), *this) + ";";
        }
        return result + "}";
    }
    std::string visit(JsonArrayConst array) {
        std::string result = "array[";
        for (JsonVariantConst value : array) result += ArduinoJson::detail::accept(value, *this) + ";";
        return result + "]";
    }
    std::string visit(JsonString value) { return value.isStatic() ? "linked-string" : "owned-string"; }
    template <class T> std::string visit(const T&) {
        if constexpr (std::is_same<T, bool>::value) return "bool";
        if constexpr (std::is_same<T, std::nullptr_t>::value) return "null";
        if constexpr (std::is_floating_point<T>::value) return "float" + std::to_string(sizeof(T));
        if constexpr (std::is_integral<T>::value) return std::is_signed<T>::value ? "signed" : "unsigned";
        CHECK(false); return "unsupported";
    }
};

namespace {
@SERIALIZERS_AND_PARSER@
}

static TraceAllocator persistenceAllocator;
static bool lastDocumentOverflow = false;
static size_t documentsCreated = 0;
struct PersistenceDocument : JsonDocument {
    PersistenceDocument() : JsonDocument(&persistenceAllocator) { ++documentsCreated; }
    ~PersistenceDocument() { lastDocumentOverflow = overflowed(); }
};
// Same JsonDocument implementation; only its allocator is controlled. This
// macro is defined after production headers, immediately before copied bodies.
#define FastBeeJsonDocLarge PersistenceDocument

static bool lockAvailable = true, failCommit = false;
struct RecursiveMutexGuard {
    explicit RecursiveMutexGuard(int, unsigned = 0) {}
    bool isLocked() const { return lockAvailable; }
};
#ifndef pdMS_TO_TICKS
#define pdMS_TO_TICKS(value) (value)
#endif
static constexpr const char* PERIPHERAL_CONFIG_FILE = "/config/peripherals.json";
static const std::string temporaryPath = std::string(PERIPHERAL_CONFIG_FILE) + ".tmp";
struct FileUtils {
    static inline size_t opens = 0, commits = 0;
    static File openAtomicWrite(const String& path) {
        ++opens;
        return LittleFS.open(path + ".tmp", "w");
    }
    static bool commitAtomicWrite(const String& from, const String& to) {
        ++commits;
        if (failCommit) return false;
        auto source = LittleFS.files.find(std::string(from));
        if (source == LittleFS.files.end()) return false;
        LittleFS.files[std::string(to)] = source->second;
        LittleFS.files.erase(source);
        return true;
    }
};

// The real JSON and manager control flow run; hardware validation and graph
// publication are observable seams. No driver initialization is linked.
struct ManagerState {
    int _mutex = 0;
    bool _configurationImportPending = false;
    bool outputClaimed = false, ordinaryClaimed = false;
    std::map<String, PeripheralConfig> peripherals;
    std::map<String, PeripheralRuntimeState> runtimeStates;
    std::map<uint8_t, String> pinToPeripheral;
    std::map<String, int> actionTickers;
    size_t validations = 0, dependencies = 0, invalidations = 0, mappings = 0, rebuilds = 0;
    bool controlOutputIsClaimed() const { return outputClaimed; }
    bool ordinaryDigitalClaimedLocked(const String&) const { return ordinaryClaimed; }
    void invalidateSensorConfigurationLocked() { ++invalidations; }
    bool validateConfig(const PeripheralConfig&, String& error) { ++validations; error = ""; return true; }
    bool validateIoDependencies(const PeripheralConfig&, const String&, String& error) {
        ++dependencies; error = ""; return true;
    }
    void updatePinMapping(const String&, const PeripheralConfig&) { ++mappings; }
    void rebuildPinMapping() { ++rebuilds; }
};
struct PeripheralManager : ManagerState { bool saveConfiguration(); bool loadConfiguration(); };
struct OracleManager : ManagerState { bool saveConfiguration(); bool loadConfiguration(); };
struct DraftManager : ManagerState { bool saveConfiguration(); bool loadConfiguration(); };

