#define millis unused_rf_millis
#define delay unused_rf_delay
#include <Arduino.h>
#undef millis
#undef delay
#include <ArduinoJson.h>
#include "core/NativeOutputControl.h"
#include "core/RfOutputContract.h"
#include "core/ManagedPinIo.h"
#include "core/SensorConfigEpoch.h"
#include "core/RuleOutputIdentity.h"
#include "core/ScreenOutputIdentity.h"
#include "managed_pin_mock_state.h"
#include <map>
#include <cstring>
namespace OC = FastBee::OrdinaryControl;
using Context = FastBee::OrdinaryControlContext;
using Result = FastBee::OrdinaryControlResult;
static int64_t rfClockUs = 1000000;
static unsigned clockReads = 0, failClockAt = 0;
static unsigned frames = 0;
static bool lockBusy = false, uartCurrent = true, adcBusy = false;
static String eventAtFrame;
int64_t esp_timer_get_time() { ++clockReads; return failClockAt == clockReads ? -1 : rfClockUs; }
unsigned long millis() { return static_cast<unsigned long>(rfClockUs / 1000); }
void delayMicroseconds(uint32_t us) { rfClockUs += us; }
int digitalRead(uint8_t pin) { return gpio_get_level(pin); }
void delay(unsigned long ms) { rfClockUs += ms * 1000; ++frames; }
void yield() {
    if (eventAtFrame == "source_uart") uartCurrent = false;
    if (eventAtFrame == "source_rule") FastBee::RuleOutputIdentity::invalidate();
    if (eventAtFrame == "source_config") FastBee::SensorConfigEpoch::advance();
    if (eventAtFrame == "source_screen") FastBee::ScreenOutputIdentity::publish(2);
    if (eventAtFrame == "expiry") rfClockUs += 30000001;
    if (eventAtFrame == "clock_failure") rfClockUs = -1;
}
namespace FastBee { bool adcPinUnavailable(uint8_t) { return adcBusy; } }
struct RecursiveMutexGuard {
    explicit RecursiveMutexGuard(int, int = -1) : locked(!lockBusy) {}
    bool isLocked() const { return locked; }
    bool locked;
};
constexpr uint8_t RF_MODE_TX = 0, RF_MODE_RX = 1;
enum class GPIOState { STATE_UNDEFINED, STATE_LOW, STATE_HIGH };
enum class PeripheralType { RF_MODULE };
enum class PeripheralStatus { PERIPHERAL_INITIALIZED, PERIPHERAL_RUNNING, PERIPHERAL_ERROR };
struct PeripheralConfig {
    String id = "rf"; PeripheralType type = PeripheralType::RF_MODULE;
    uint8_t pinCount = 1, pins[1] = {18}; bool enabled = true;
    struct { struct {
        uint8_t mode = RF_MODE_TX, bitLength = 24, repeat = 3;
        uint16_t pulseWidth = 350; bool activeHigh = true;
    } rf; } params;
    uint8_t getPrimaryPin() const { return pins[0]; }
    bool isExpanderChannel() const { return false; }
    bool isModbusPeripheral() const { return false; }
};
struct PeripheralRuntimeState {
    OC::Lease ordinaryControl;
    uint32_t ordinaryStopFailures = 0;
    uint64_t ordinaryRetryAfterMs = 0;
    bool memorySuspended = false, memoryCleanupPending = false;
    PeripheralStatus status = PeripheralStatus::PERIPHERAL_RUNNING;
    String lastError; unsigned long lastActivity = 0;
    struct { struct { uint32_t bytesSent = 0; } comm; struct { GPIOState currentState = GPIOState::STATE_UNDEFINED; } gpio; } state;
};
class PeripheralManager {
public:
    static PeripheralManager& getInstance() { static PeripheralManager pm; return pm; }
    struct ActionTickerData {
        OC::Permit ordinaryPermit;
        struct Timer { bool stopAndDelete() { assert(false); return false; } } ordinaryTimer;
    };
    std::map<String, ActionTickerData*> actionTickers;
    std::map<String, PeripheralConfig> peripherals;
    std::map<String, PeripheralRuntimeState> runtimeStates;
    FastBee::ManagedPinIo _managedPinIo;
    int _mutex = 1; bool dedicated = false, pinConflict = false;
    uint64_t _nextOrdinaryControlOperation = 0, _nextOrdinaryControlGeneration = 0;
    bool isValidPin(uint8_t pin) const { return pin <= 39; }
    bool isReservedPin(uint8_t pin) const { return pin == 6; }
    bool isInputOnlyPin(uint8_t pin) const { return pin >= 34; }
    bool controlOutputPinIsClaimed(uint8_t) const { return dedicated; }
    bool controlOutputIsClaimed(const String&) const { return dedicated; }
    bool checkPinConflict(uint8_t, const String&) const { return pinConflict; }
    bool managedPinAvailableForAdc(uint8_t pin) const { return !_managedPinIo.hasGpio(pin) && !_managedPinIo.hasDac(pin); }
    bool ordinaryDigitalClaimedLocked(const String& id) const { return runtimeStates.at(id).ordinaryControl.phase != OC::Phase::Idle; }
    bool ordinaryBackendSupportedLocked(const PeripheralConfig& config) const {
        return config.type == PeripheralType::RF_MODULE && config.params.rf.mode == RF_MODE_TX && config.pinCount == 1;
    }
    bool ordinaryBackendQuiescentLocked(const String& id) const { return ordinaryRfQuiescentLocked(id); }
    bool ordinaryProducerPresentLocked(const String&) const { return false; }
    bool retireOrdinaryIoProducerLocked(const String&, bool) { return true; }
    bool retireOrdinaryMotionLocked(const String&, bool, bool*) { return true; } // No motion target here.
    void finishOrdinaryModbusLocked(const Context&, bool) {} // No protocol target here.
    bool isUartEventOriginCurrent(const FastBee::UartEventOrigin& origin) const { return origin.unbound() || uartCurrent; }
    bool beginOrdinaryControl(OC::Source, uint64_t, uint32_t, bool, uint64_t,
        const String&, uint32_t, const FastBee::UartEventOrigin&, Context&);
    bool ordinaryPermitCurrentLocked(const String&, const OC::Permit&) const;
    bool retireOrdinaryDigitalLocked(const String&, uint64_t, bool = false, bool = false, bool* = nullptr);
    void updateOrdinaryControlResultLocked(const String&, uint64_t, Result&) const;
    bool completeOrdinaryControlLocked(const String&, uint64_t, Result&, bool,
                                      const char* = "CONTROL_OUTPUT_UNCONFIRMED");
    bool inspectOrdinaryControlLocked(const String&, const Context&, OC::Intent, Result&, uint64_t&);
    bool commitOrdinaryControlLocked(const String&, const Context&, OC::Intent, Result&, uint64_t&, bool, OC::Permit&);
    void finishOrdinaryControl(const Context&, bool = false);
    bool setupRfTransmit(const PeripheralConfig&);
    bool releaseRfTransmit(const PeripheralConfig&);
    bool retireOrdinaryRfLocked(const String&, bool* = nullptr);
    bool ordinaryRfQuiescentLocked(const String&) const;
    bool sendRfCode(const String&, const String&, uint32_t = 0, uint32_t = 0, uint32_t = 0,
                    const Context* = nullptr, Result* = nullptr);
    bool readRfLevel(const String&, bool&);
    PeripheralConfig* getPeripheral(const String& id) {
        const auto found = peripherals.find(id); return found == peripherals.end() ? nullptr : &found->second;
    }
};
// @dispatch_helpers@
// @production@
// @action_boundary@
static Context begin(PeripheralManager& pm, OC::Source source = OC::Source::Http, uint64_t actor = 1) {
    Context context;
    assert(pm.beginOrdinaryControl(source, actor, OC::isManual(source) ? 30000 : 0, false, 0, "",
        FastBee::SensorConfigEpoch::current(), {}, context));
    return context;
}
int main(int argc, char** argv) {
    assert(argc == 2); const String mode = argv[1];
    assert(allCalls() == 0);
    auto& pm = PeripheralManager::getInstance();
    pm.peripherals["rf"] = {}; pm.runtimeStates["rf"] = {};
    auto& config = pm.peripherals.at("rf"); auto& state = pm.runtimeStates.at("rf");
    Result result;
    if (mode == "decode") {
        FastBee::RfOutputFrame frame;
        for (const char* code : {"4294967295", "0xFFFFFFFF", "FFFFFFFF", "0b11111111111111111111111111111111"})
            assert(FastBee::resolveRfOutputFrame(code, std::strlen(code), 32, 100, 1, 24, 350, 3, frame) && frame.code == UINT32_MAX);
        for (const char* code : {"-1", "+1", "4294967296", "0x100000000", "FFFFFFFFF", "1_2", " 1", "1 ", "0b2", "0x", "0b"})
            assert(!FastBee::resolveRfOutputFrame(code, std::strlen(code), 32, 100, 1, 24, 350, 3, frame));
        assert(!FastBee::resolveRfOutputFrame("1\0junk", 6, 32, 100, 1, 24, 350, 3, frame));
        assert(FastBee::resolveRfOutputFrame("0b001", 5, 0, 0, 0, 24, 350, 3, frame) && frame.bits == 3);
        assert(!FastBee::resolveRfOutputFrame("256", 3, 8, 100, 1, 24, 350, 3, frame)); return 0;
    }
    if (mode == "setup_failed" || mode == "setup_partial") {
        failure = mode == "setup_failed" ? Op::Level : Op::Config;
        assert(!pm.setupRfTransmit(config) && pm._managedPinIo.hasGpio(18));
        assert(state.lastError == "RF_SETUP_UNCONFIRMED");
        failure = Op::Count; assert(pm.releaseRfTransmit(config) && !pm._managedPinIo.hasGpio(18)); return 0;
    }
    if (mode == "setup_collision") {
        buses[18] = ESP32_BUS_TYPE_LEDC;
        assert(!pm.setupRfTransmit(config) && !count(Op::Level)); return 0;
    }
    config.params.rf.activeHigh = !(mode == "active_low" || mode == "release_active_low" || mode == "release_failed");
    assert(pm.setupRfTransmit(config)); assert(levels[18] == (config.params.rf.activeHigh ? 0 : 1));
    assert(pm.setupRfTransmit(config)); // Checked same-owner setup remains repeatable before admission.
    if (mode == "release_active_low" || mode == "release_failed") {
        assert(pm._managedPinIo.write("rf", false, 18, false));
        if (mode == "release_failed") failure = Op::Config;
        assert(pm.releaseRfTransmit(config) == (mode == "release_active_low")); assert(levels[18] == 1);
        if (mode == "release_failed") {
            assert(pm._managedPinIo.hasGpio(18)); failure = Op::Count;
            assert(pm.releaseRfTransmit(config) && levels[18] == 1);
        }
        return 0;
    }
    const unsigned before = count(Op::Level);
    if (mode == "tx_read_unavailable") {
        state.state.comm.bytesSent = 999;
        bool level = true;
        assert(!pm.readRfLevel("rf", level) && !level && !count(Op::Read));
        assert(state.state.comm.bytesSent == 999); return 0;
    }
    // Production uses 32-bit millis even on this 64-bit host. The source and
    // lease clocks remain monotonic while the operation clock wraps normally.
    if (mode == "operation_deadline_wrap") rfClockUs = (int64_t(UINT32_MAX) - 3) * 1000;
    auto context = begin(pm);
    if (mode.startsWith("operation_deadline")) {
        const bool zero = mode == "operation_deadline_zero";
        context.operationDeadlineAt = static_cast<uint32_t>(millis()) + (zero ? 0U : 6U);
        // Each 8-bit/100us frame advances the actual mock by 6.4ms + 1ms.
        // A deadline within that frame allows its inactive terminal boundary,
        // then rejects the next frame (or final success for a one-frame train).
        const uint32_t repeat = mode == "operation_deadline_final" ? 1 : 3;
        assert(!pm.sendRfCode("rf", "1", 8, 100, repeat, &context, &result));
        assert(!result.accepted && result.attempted == !zero);
        assert(std::strcmp(result.reason, "RF_OPERATION_DEADLINE_EXCEEDED") == 0);
        assert(frames == (zero ? 0U : 1U));
        assert(count(Op::Level) == before + (zero ? 0U : 18U));
        assert(levels[18] == 0 && state.state.comm.bytesSent == 0);
        assert(state.ordinaryControl.phase == OC::Phase::Fault);
        if (mode == "operation_deadline_cleanup") {
            // A later cleanup error retains ownership; it may only retry
            // inactive/release, never replay a code that partially transmitted.
            failure = Op::Config;
            assert(!pm._managedPinIo.release("rf", false, 18));
            pm.finishOrdinaryControl(context);
            assert(state.ordinaryControl.phase == OC::Phase::Fault && pm._managedPinIo.hasGpio(18));
            const unsigned afterFailure = count(Op::Level);
            failure = Op::Count;
            rfClockUs += 1000000; // Honor the production retirement backoff before retrying cleanup.
            pm.finishOrdinaryControl(context);
            assert(state.ordinaryControl.phase == OC::Phase::Idle && !pm._managedPinIo.hasGpio(18));
            assert(frames == 1 && count(Op::Level) == afterFailure + 1 && levels[18] == 0);
        } else {
            pm.finishOrdinaryControl(context);
            assert(state.ordinaryControl.phase == OC::Phase::Idle);
            assert(frames == (zero ? 0U : 1U) && count(Op::Level) == before + (zero ? 0U : 18U));
        }
        return 0;
    }
    if (mode == "zero_frame") {
        failClockAt = clockReads + 2; // Commit inspection succeeds; first frame boundary cannot confirm time.
        assert(!pm.sendRfCode("rf", "1", 8, 100, 3, &context, &result));
        assert(!result.attempted && !frames && count(Op::Level) == before);
        assert(state.ordinaryControl.phase == OC::Phase::Fault);
        pm.finishOrdinaryControl(context);
        assert(state.ordinaryControl.phase == OC::Phase::Idle && count(Op::Level) == before); return 0;
    }
    if (mode == "no_context") {
        assert(!pm.sendRfCode("rf", "1", 8, 100, 1, nullptr, &result));
        assert(!result.attempted && count(Op::Level) == before && !std::strcmp(result.reason, "CONTROL_CONTEXT_REQUIRED")); return 0;
    }
    if (mode == "parameters") {
        for (const uint32_t bits : {33U, 256U, UINT32_MAX})
            assert(!pm.sendRfCode("rf", "1", bits, 100, 1, &context, &result));
        assert(!pm.sendRfCode("rf", "1", 8, 99, 1, &context, &result));
        assert(!pm.sendRfCode("rf", "1", 8, 100, 21, &context, &result));
        assert(!pm.sendRfCode("rf", "256", 8, 100, 1, &context, &result));
        assert(count(Op::Level) == before && state.ordinaryControl.phase == OC::Phase::Idle); return 0;
    }
    if (mode.startsWith("call_")) {
        const auto call = [&](const String& raw, const String& effective = "", const String& received = "") {
            return FastBee::executeRfOutputAction(pm, "rf", raw, effective, received, &context, &result);
        };
        if (mode == "call_plain") assert(call("0b101"));
        else if (mode == "call_json") assert(call("{\"action\":\"send\",\"value\":\"0xA\",\"bits\":4,\"pulseWidth\":100,\"repeat\":1}"));
        else if (mode == "call_template") assert(call("{\"action\":\"send\",\"code\":\"$value\",\"bits\":8,\"repeat\":1}", "1", "2"));
        else if (mode == "call_invalid") {
            for (const char* raw : {"-1", "4294967296", "{\"code\":\"1\",\"bits\":256}",
                "{\"code\":\"1\",\"bits\":1.0}", "{\"code\":\"1\",\"repeat\":true}",
                "{\"code\":\"1\",\"repeat\":-1}", "{\"code\":\"1\",\"pulseWidth\":99}",
                "{\"code\":\"1\",\"periphId\":\"different\"}", "{\"code\":\"1\",\"actor\":9}",
                "{\"code\":\"1\",\"value\":\"2\"}", "{\"code\":\"1\\u0000evil\"}"}) assert(!call(raw));
            assert(count(Op::Level) == before && !result.attempted); return 0;
        } else return 2;
        assert(count(Op::Level) > before && result.accepted && result.actor.identity == 1); return 0;
    }
    if (mode == "dedicated") pm.dedicated = true;
    if (mode == "not_ready") state.memorySuspended = true;
    if (mode == "source_uart") context.uartOrigin = FastBee::UartEventOrigin::captured(7, 19);
    if (mode == "source_rule") { context.ruleBound = true; context.ruleEpoch = FastBee::RuleOutputIdentity::currentEpoch(); }
    if (mode == "source_screen") {
        FastBee::ScreenOutputIdentity::publish(1);
        context = begin(pm, OC::Source::Screen, (uint64_t(1) << 32) | 1U);
    }
    if (mode.startsWith("source_") || mode == "expiry" || mode == "clock_failure") eventAtFrame = mode;
    if (mode == "active_write_failed" || mode == "inactive_write_failed" || mode == "cleanup_failed") {
        failure = Op::Level;
        failureCall = mode == "active_write_failed" ? before + 1 : before + 2;
    }
    if (mode == "counter_saturates") state.state.comm.bytesSent = UINT32_MAX - 1;
    const bool ok = pm.sendRfCode("rf", "1", 8, 100, 3, &context, &result);
    if (mode == "dedicated" || mode == "not_ready") {
        assert(!ok && !result.attempted && count(Op::Level) == before); return 0;
    }
    if (mode.startsWith("source_") || mode == "expiry" || mode == "clock_failure") {
        assert(!ok && result.attempted && frames == 1 && count(Op::Level) == before + 18);
        assert(!state.state.comm.bytesSent && !std::strcmp(result.reason, "RF_SOURCE_UNCONFIRMED"));
        assert(levels[18] == (config.params.rf.activeHigh ? 0 : 1)); return 0;
    }
    if (mode == "active_write_failed" || mode == "inactive_write_failed" || mode == "cleanup_failed") {
        assert(!ok && result.attempted && state.ordinaryControl.phase == OC::Phase::Fault && !frames);
        if (mode == "cleanup_failed") { failureCall = 0; pm.finishOrdinaryControl(context); assert(pm._managedPinIo.hasGpio(18)); }
        failure = Op::Count; rfClockUs += 2000000; pm.finishOrdinaryControl(context);
        assert(!pm._managedPinIo.hasGpio(18) && state.ordinaryControl.phase == OC::Phase::Idle);
        const unsigned stopped = count(Op::Level);
        auto next = begin(pm); assert(!pm.sendRfCode("rf", "1", 8, 100, 1, &next, &result));
        assert(count(Op::Level) == stopped); return 0;
    }
    assert(ok && result.attempted && result.accepted && frames == 3 && count(Op::Level) == before + 54);
    assert(levels[18] == (config.params.rf.activeHigh ? 0 : 1));
    pm.finishOrdinaryControl(context);
    assert(state.ordinaryControl.phase == OC::Phase::Held);
    if (mode == "conflict") {
        const unsigned writes = count(Op::Level); auto other = begin(pm, OC::Source::Mqtt, 44);
        assert(!pm.sendRfCode("rf", "1", 8, 100, 1, &other, &result) && count(Op::Level) == writes);
        assert(!pm.releaseRfTransmit(config));
    }
    if (mode == "counter_saturates") assert(state.state.comm.bytesSent == UINT32_MAX);
    return 0;
}
