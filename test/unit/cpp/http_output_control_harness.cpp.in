#include <Arduino.h>
#include <ArduinoJson.h>
#include "core/NativeOutputControl.h"
#include "core/ActionValueContract.h"
#include <cassert>
#include <cstring>
#include <string>
#include <vector>
inline void convertToJson(const String& value, JsonVariant destination) { destination.set(value.c_str()); }
struct AsyncWebParameter {
    String key, text; bool post = true, file = false;
    const String& name() const { return key; }
    const String& value() const { return text; }
    bool isPost() const { return post; }
    bool isFile() const { return file; }
};
class AsyncWebServerRequest {
public:
    std::vector<AsyncWebParameter> values;
    void add(const char* key, const char* value, bool post = true) { values.push_back({key,value,post,false}); }
    size_t params() const { return values.size(); }
    const AsyncWebParameter* getParam(size_t index) const { return index < values.size() ? &values[index] : nullptr; }
    const AsyncWebParameter* getParam(const char* key, bool post) const {
        for (const auto& value : values) if (value.key == key && value.post == post) return &value;
        return nullptr;
    }
    bool hasParam(const char* key, bool post) const { return getParam(key, post) != nullptr; }
};
struct AuthResult { bool success = true; uint64_t outputActor = 42; };
class WebHandlerContext {
public:
    AuthResult auth;
    int status = 0;
    String error;
    std::string body;
    AuthResult authenticateRequest(AsyncWebServerRequest*) { return auth; }
    void sendError(AsyncWebServerRequest*, int code, const char* reason) { status=code;error=reason; }
    void sendJsonResponse(AsyncWebServerRequest*, int code, const JsonDocument& doc) { status=code;serializeJson(doc,body); }
};
enum class PeripheralType { GPIO_DIGITAL_OUTPUT, GPIO_PWM_OUTPUT, GPIO_ANALOG_OUTPUT, DAC, PWM_SERVO, RF_MODULE };
constexpr uint8_t RF_MODE_TX = 0;
struct PeripheralConfig {
    PeripheralType type = PeripheralType::GPIO_PWM_OUTPUT;
    struct { struct {
        uint8_t pwmResolution = 8, aoMinPct = 0, aoMaxPct = 100;
        bool aoMode = false, passive = false;
    } gpio;
    struct { uint8_t pwmResolution = 16; uint16_t minAngle = 10, maxAngle = 170; } servo;
    struct { uint8_t mode = RF_MODE_TX, bitLength = 24, repeat = 3; uint16_t pulseWidth = 350; } rf; } params;
    bool isExpanderChannel() const { return false; }
    bool isModbusPeripheral() const { return false; }
};
class PeripheralManager {
public:
    static PeripheralManager& getInstance() { static PeripheralManager value; return value; }
    unsigned begins=0, submits=0, finishes=0;
    bool cancelled=false, accept=true, beginAllowed=true;
    uint32_t currentEpoch=7, interval=0;
    FastBee::DigitalOutputCommand command{};
    FastBee::ScalarOutputCommand scalarCommand{};
    uint32_t scalarValue = 0;
    int64_t servoValue = 0; bool servoRaw = false;
    bool submitOrdinaryServo(const String& id, int64_t value, bool raw,
        const FastBee::OrdinaryControlContext* context, FastBee::OrdinaryControlResult* out) {
        assert(context && out); ++submits; servoValue = value; servoRaw = raw;
        *out = next; out->evaluated = true; std::strncpy(out->targetId, id.c_str(), sizeof(out->targetId) - 1);
        return accept;
    }
    PeripheralConfig config;
    String rfCode;
    uint32_t rfBits = 0, rfPulse = 0, rfRepeat = 0;
    bool sendRfCode(const String& id, const String& code, uint32_t bits, uint32_t pulse, uint32_t repeat,
        const FastBee::OrdinaryControlContext* context, FastBee::OrdinaryControlResult* result) {
        assert(context && result); ++submits; rfCode = code; rfBits = bits; rfPulse = pulse; rfRepeat = repeat;
        *result = next; result->evaluated = true;
        std::strncpy(result->targetId, id.c_str(), sizeof(result->targetId) - 1); return accept;
    }
    bool getPeripheralSnapshot(const String& id, PeripheralConfig& result, uint32_t* epoch) {
        if (id != "relay") return false;
        result = config; *epoch = currentEpoch; return true;
    }
    bool submitOrdinaryScalar(const String& id, FastBee::ScalarOutputCommand cmd, uint32_t value,
        const FastBee::OrdinaryControlContext&, FastBee::OrdinaryControlResult& out) {
        ++submits; scalarCommand = cmd; scalarValue = value; out = next; out.evaluated = true;
        std::strncpy(out.targetId, id.c_str(), sizeof(out.targetId) - 1);
        return accept;
    }
    FastBee::OrdinaryControlContext captured;
    FastBee::OrdinaryControlResult next;
    bool beginOrdinaryControl(FastBee::OrdinaryControl::Source source, uint64_t actor,
        uint32_t hold, bool confirmed, uint64_t generation, const String& target,
        uint32_t epoch, const FastBee::UartEventOrigin& origin, FastBee::OrdinaryControlContext& context) {
        ++begins;
        if (!beginAllowed || !epoch || epoch!=currentEpoch) return false;
        context.request.actor={source,actor};context.request.holdMs=hold;
        context.request.overrideConfirmed=confirmed;context.request.reviewedGeneration=generation;
        context.configEpoch=epoch;context.uartOrigin=origin;context.request.operation=begins;
        std::strncpy(context.reviewedTargetId,target.c_str(),sizeof(context.reviewedTargetId)-1);
        captured=context;return true;
    }
    bool submitOrdinaryDigital(const String& id, FastBee::DigitalOutputCommand cmd, uint32_t delay,
        const FastBee::OrdinaryControlContext&, FastBee::OrdinaryControlResult& out) {
        ++submits;command=cmd;interval=delay;out=next;out.evaluated=true;
        std::strncpy(out.targetId,id.c_str(),sizeof(out.targetId)-1);
        return accept;
    }
    void finishOrdinaryControl(const FastBee::OrdinaryControlContext&, bool cancel) { ++finishes;cancelled=cancel; }
};
namespace FastBee { void writeOrdinaryControlJson(JsonObject, const OrdinaryControlResult&); }
// @actual_http_boundary@
static AsyncWebServerRequest request(const char* key="state",const char* value="1") {
    AsyncWebServerRequest result;result.add("id","relay");result.add(key,value);return result;
}
static void reset() { PeripheralManager::getInstance()=PeripheralManager{}; }
static void write(WebHandlerContext& web,AsyncWebServerRequest& req,uint32_t epoch=7) {
    FastBee::handleHttpNativeDigital(web,&req,"relay",epoch);
}
int main(int argc,char**argv) {
    assert(argc==2);const std::string mode=argv[1];auto& pm=PeripheralManager::getInstance();
    using namespace FastBee;namespace OC=FastBee::OrdinaryControl;
    if (mode.rfind("motor_",0)==0) {
        AsyncWebServerRequest req;req.add("motorRef","motor.2.saved");req.add("action","forward");req.add("requestId","click-1");
        WebHandlerContext web;OrdinaryControlContext context;
        if(mode=="motor_identity") {
            req.add("value","65535");
            assert(beginHttpMotorOutput(web,&req,"mb:1:2",7,context));
            assert(context.request.actor.source==OC::Source::Http && context.request.actor.identity==42);
            assert(context.request.holdMs==30000 && context.configEpoch==7 && !pm.submits);
            reset();web.auth.outputActor=0;
            assert(!beginHttpMotorOutput(web,&req,"mb:1:2",7,context) && web.status==401 && !pm.begins);
        } else if(mode=="motor_fields") {
            for(const char* key:{"actor","source","operation","motorRef","unknown"}) {
                reset();auto malformed=req;malformed.add(key,"forged");
                assert(!beginHttpMotorOutput(web,&malformed,"mb:1:2",7,context) && web.status==400 && !pm.begins);
            }
            for(const char* value:{"-1","65536","1.5"," 1","1x","4294967296"}) {
                reset();auto malformed=req;malformed.add("value",value);
                assert(!beginHttpMotorOutput(web,&malformed,"mb:1:2",7,context) && !pm.begins);
            }
            reset();auto query=req;query.add("holdMs","100",false);
            assert(!beginHttpMotorOutput(web,&query,"mb:1:2",7,context) && !pm.begins);
        } else if(mode=="motor_review") {
            req.add("confirmOverride","true");req.add("controlTargetId","mb:1:2");
            req.add("controlGeneration","18446744073709551615");req.add("controlConfigEpoch","7");
            assert(beginHttpMotorOutput(web,&req,"mb:1:2",7,context));
            assert(context.request.overrideConfirmed && context.request.reviewedGeneration==UINT64_MAX);
            reset();assert(!beginHttpMotorOutput(web,&req,"mb:2:2",7,context) && !pm.begins);
            reset();assert(!beginHttpMotorOutput(web,&req,"mb:1:2",8,context) && !pm.begins);
        } else return 2;
        return 0;
    }
    if (mode.rfind("rf_", 0) == 0) {
        pm.config.type = PeripheralType::RF_MODULE;
        const auto send = [&](WebHandlerContext& web, AsyncWebServerRequest& req, uint32_t epoch = 7) {
            handleHttpRfOutput(web, &req, "relay", epoch);
        };
        if (mode == "rf_identity") {
            auto req = request("code", "0x123"); req.add("bits", "12"); req.add("repeat", "2");
            WebHandlerContext web; send(web, req);
            assert(web.status == 200 && pm.begins == 1 && pm.submits == 1 && pm.finishes == 1);
            assert(pm.rfCode == "0x123" && pm.rfBits == 12 && pm.rfRepeat == 2);
            assert(pm.captured.request.actor.source == OC::Source::Http && pm.captured.request.actor.identity == 42);
        } else if (mode == "rf_parameters") {
            for (const char* code : {"-1", "+1", "4294967296", "0x100000000", " 1", "1_2"}) {
                auto req = request("code", code); WebHandlerContext web; send(web, req);
                assert(web.status == 400 && !pm.begins && !pm.submits);
            }
            for (const char* value : {"-1", "33", "256", "1.5", "4294967296"}) {
                auto req = request("code", "1"); req.add("bits", value); WebHandlerContext web; send(web, req);
                assert(web.status == 400 && !pm.begins && !pm.submits);
            }
            auto width = request("code", "256"); width.add("bits", "8"); WebHandlerContext web; send(web, width);
            assert(web.status == 400 && !pm.submits);
        } else if (mode == "rf_fields") {
            for (const char* key : {"actor", "source", "operation", "unknown", "data", "code"}) {
                auto req = request("code", "1"); req.add(key, "1"); WebHandlerContext web; send(web, req);
                assert(web.status == 400 && !pm.submits);
            }
            auto req = request("code", "1"); req.add("bits", "24"); req.add("bitLength", "24");
            WebHandlerContext web; send(web, req); assert(web.status == 400 && !pm.submits);
        } else if (mode == "rf_context") {
            auto req = request("code", "1"); WebHandlerContext stale; send(stale, req, 8);
            assert(stale.status == 409 && !pm.begins);
            WebHandlerContext missing; missing.auth.outputActor = 0; send(missing, req);
            assert(missing.status == 401 && !pm.submits);
            WebHandlerContext badReview; req.add("confirmOverride", "true"); req.add("controlGeneration", "2");
            req.add("controlConfigEpoch", "7"); req.add("controlTargetId", "elsewhere"); send(badReview, req);
            assert(badReview.status == 400 && !pm.submits);
        } else if (mode == "rf_failure") {
            pm.accept = false; pm.next.attempted = true; pm.next.reason = "RF_TX_WRITE_UNCONFIRMED";
            auto req = request("code", "1"); WebHandlerContext web; send(web, req);
            assert(web.status == 503 && pm.submits == 1 && pm.finishes == 1);
            JsonDocument doc; assert(!deserializeJson(doc, web.body));
            assert(doc["data"]["control"]["physicalVerified"] == false);
            assert(doc["data"]["control"]["canConfirmOverride"] == false);
        } else return 2;
        return 0;
    }
    if (mode.rfind("modbus_", 0) == 0) {
        auto valid = [] { AsyncWebServerRequest req; req.add("slaveAddress","2"); req.add("channel","1");
            req.add("coilBase","10"); req.add("mode","coil"); req.add("action","on"); return req; };
        if (mode == "modbus_identity") {
            auto req=valid(); WebHandlerContext web; OrdinaryControlContext context;
            assert(beginHttpModbusRelayOutput(web,&req,"mb:1:2",7,context));
            assert(pm.begins==1 && !pm.submits && context.request.actor.identity==42);
            assert(context.request.actor.source==OC::Source::Http && context.request.holdMs==30000);
            reset(); web.auth.outputActor=0; assert(!beginHttpModbusRelayOutput(web,&req,"mb:1:2",7,context));
            assert(!pm.begins && web.status==401);
        } else if (mode == "modbus_fields") {
            for (const char* key : {"actor","source","operation","slaveAddress","unknown"}) {
                reset();auto req=valid();req.add(key,"1");WebHandlerContext web;OrdinaryControlContext context;
                assert(!beginHttpModbusRelayOutput(web,&req,"mb:1:2",7,context) && !pm.begins && web.status==400);
            }
            for (const char* bad : {"-1","248","1x","2.0"}) {
                reset();auto req=valid();req.values[0].text=bad;WebHandlerContext web;OrdinaryControlContext context;
                assert(!beginHttpModbusRelayOutput(web,&req,"mb:1:2",7,context) && !pm.begins);
            }
            reset();auto req=valid();req.values[0].post=false;WebHandlerContext web;OrdinaryControlContext context;
            assert(!beginHttpModbusRelayOutput(web,&req,"mb:1:2",7,context) && !pm.begins);
        } else if (mode == "modbus_review") {
            auto req=valid();req.add("confirmOverride","true");req.add("controlTargetId","mb:1:2");
            req.add("controlGeneration","18446744073709551615");req.add("controlConfigEpoch","7");
            WebHandlerContext web;OrdinaryControlContext context;
            assert(beginHttpModbusRelayOutput(web,&req,"mb:1:2",7,context) && context.request.reviewedGeneration==UINT64_MAX);
            reset();req.values[6].text="mb:2:2";WebHandlerContext wrong;
            assert(!beginHttpModbusRelayOutput(wrong,&req,"mb:1:2",7,context) && !pm.begins);
        } else return 2;
        return 0;
    }
    if (mode.rfind("servo_", 0) == 0) {
        const auto servo = [&](WebHandlerContext& web, AsyncWebServerRequest& req) {
            pm.config.type = PeripheralType::PWM_SERVO; handleHttpServoOutput(web, &req, "relay", 7);
        };
        if (mode == "servo_raw" || mode == "servo_angle") {
            auto req = request(mode == "servo_raw" ? "pwm" : "angle", mode == "servo_raw" ? "4096" : "90");
            req.add("holdMs", "7000"); WebHandlerContext web; servo(web, req);
            assert(web.status == 200 && pm.begins == 1 && pm.submits == 1 && pm.finishes == 1);
            assert(pm.servoRaw == (mode == "servo_raw") && pm.servoValue == (pm.servoRaw ? 4096 : 90));
            assert(pm.captured.request.actor.source == OC::Source::Http && pm.captured.request.actor.identity == 42);
            assert(pm.captured.request.holdMs == 7000 && pm.captured.configEpoch == 7);
        } else if (mode == "servo_parameters") {
            for (const auto value : {"", "-1", "65536", "2.5", "nan", "1x", "99999999999999999999"}) {
                reset(); auto req = request("pwm", value); WebHandlerContext web; servo(web, req);
                assert(web.status == 400 && !pm.submits && !pm.begins);
            }
            for (const auto value : {"9", "171", "360", "-1", "10.5", ""}) {
                reset(); auto req = request("angle", value); WebHandlerContext web; servo(web, req);
                assert(web.status == 400 && !pm.submits && !pm.begins);
            }
            reset(); pm.config.params.servo.pwmResolution = 8;
            auto wide = request("pwm", "256"); WebHandlerContext range; servo(range, wide);
            assert(range.status == 400 && !pm.submits);
            reset(); auto mixed = request("angle", "90"); mixed.add("pwm", "10");
            WebHandlerContext mix; servo(mix, mixed); assert(mix.status == 400 && !pm.submits);
        } else if (mode == "servo_fields") {
            for (const auto key : {"id", "pwm", "source", "actor", "operation", "action", "value", "channel"}) {
                reset(); auto req = request("pwm", "10"); req.add(key, "1");
                WebHandlerContext web; servo(web, req); assert(web.status == 400 && !pm.begins && !pm.submits);
            }
            reset(); auto query = request("pwm", "10"); query.add("holdMs", "30", false);
            WebHandlerContext web; servo(web, query); assert(web.status == 400 && !pm.submits);
        } else if (mode == "servo_context") {
            auto req = request("angle", "90"); pm.currentEpoch = 8;
            WebHandlerContext stale; servo(stale, req); assert(stale.status == 409 && !pm.submits && !pm.begins);
            reset(); WebHandlerContext noAuth; noAuth.auth.outputActor = 0;
            servo(noAuth, req); assert(noAuth.status == 401 && !pm.submits);
            reset(); req.add("holdMs", "0"); WebHandlerContext noHold;
            servo(noHold, req); assert(noHold.status == 400 && !pm.begins);
        } else if (mode == "servo_review") {
            auto req = request("pwm", "10"); req.add("confirmOverride", "true");
            req.add("controlTargetId", "relay"); req.add("controlGeneration", "18446744073709551615");
            req.add("controlConfigEpoch", "7"); WebHandlerContext web; servo(web, req);
            assert(web.status == 200 && pm.captured.request.reviewedGeneration == UINT64_MAX);
            reset(); req.values[3].text = "other"; WebHandlerContext bad;
            servo(bad, req); assert(bad.status == 400 && !pm.submits);
        } else if (mode == "servo_unknown") {
            pm.accept = false; pm.next.attempted = true; pm.next.reason = "SERVO_WRITE_UNCONFIRMED";
            auto req = request("pwm", "10"); WebHandlerContext web; servo(web, req);
            assert(web.status == 503 && pm.submits == 1 && pm.finishes == 1);
            JsonDocument doc; assert(!deserializeJson(doc, web.body));
            assert(doc["data"]["control"]["physicalVerified"] == false && doc["data"]["control"]["canConfirmOverride"] == false);
        } else return 2;
        return 0;
    }
    if (mode.rfind("scalar_", 0) == 0) {
        const auto scalar = [&](WebHandlerContext& web, AsyncWebServerRequest& req) {
            handleHttpNativeScalar(web, &req, "relay", 7);
        };
        if (mode == "scalar_pwm" || mode == "scalar_dac") {
            const bool dac = mode == "scalar_dac";
            if (dac) pm.config.type = PeripheralType::DAC;
            auto req = request(dac ? "value" : "pwm", "255");
            req.add("holdMs", "7000"); WebHandlerContext web; scalar(web, req);
            assert(web.status == 200 && pm.begins == 1 && pm.submits == 1 && pm.finishes == 1);
            assert(pm.scalarValue == 255 && pm.scalarCommand == (dac ? ScalarOutputCommand::Dac : ScalarOutputCommand::Pwm));
            assert(pm.captured.request.actor.source == OC::Source::Http && pm.captured.request.actor.identity == 42);
            assert(pm.captured.request.holdMs == 7000 && pm.captured.configEpoch == 7);
        } else if (mode == "scalar_passive") {
            pm.config.type = PeripheralType::GPIO_DIGITAL_OUTPUT; pm.config.params.gpio.passive = true;
            auto req = request("state", "1"); WebHandlerContext web; scalar(web, req);
            assert(web.status == 200 && pm.scalarCommand == ScalarOutputCommand::Pwm && pm.scalarValue == 127);
            assert(pm.captured.request.actor.source == OC::Source::Http && pm.captured.request.actor.identity == 42);
        } else if (mode == "scalar_toggle") {
            auto req = request("toggle", "true"); WebHandlerContext web; scalar(web, req);
            assert(web.status == 200 && pm.scalarCommand == ScalarOutputCommand::Toggle && !pm.scalarValue);
            reset(); auto forged = request("toggle", "false"); WebHandlerContext bad; scalar(bad, forged);
            assert(bad.status == 400 && !pm.submits);
        } else if (mode == "scalar_blink") {
            auto req = request("action", "blink"); req.add("intervalMs", "250");
            WebHandlerContext web; scalar(web, req);
            assert(web.status == 200 && pm.scalarCommand == ScalarOutputCommand::Blink && pm.scalarValue == 250);
            reset(); req.add("periodMs", "500"); WebHandlerContext mixed; scalar(mixed, req);
            assert(mixed.status == 400 && !pm.submits);
        } else if (mode == "scalar_waveform_rejected") {
            pm.config.type = PeripheralType::GPIO_ANALOG_OUTPUT;
            auto req = request("action", "blink"); req.add("intervalMs", "250");
            WebHandlerContext ao; scalar(ao, req); assert(ao.status == 400 && !pm.submits);
            reset(); pm.config.type = PeripheralType::GPIO_DIGITAL_OUTPUT; pm.config.params.gpio.passive = true;
            auto breath = request("action", "breathe"); breath.add("periodMs", "1000");
            WebHandlerContext passive; scalar(passive, breath); assert(passive.status == 400 && !pm.submits);
            reset(); pm.config.type = PeripheralType::DAC;
            auto toggle = request("toggle", "1"); WebHandlerContext dac; scalar(dac, toggle);
            assert(dac.status == 400 && !pm.submits);
        } else if (mode == "scalar_invalid") {
            for (const char* value : {"-1", "256", "1.5", "nan", "999999999999999999999999"}) {
                reset(); auto req = request("pwm", value); WebHandlerContext web; scalar(web, req);
                assert(web.status == 400 && !pm.begins && !pm.submits);
            }
            reset(); auto mixed = request("pwm", "1"); mixed.add("state", "0");
            WebHandlerContext mixedWeb; scalar(mixedWeb, mixed); assert(mixedWeb.status == 400 && !pm.submits);
            reset(); auto forged = request("pwm", "1"); forged.add("source", "rule");
            WebHandlerContext forgedWeb; scalar(forgedWeb, forged); assert(forgedWeb.status == 400 && !pm.submits);
            reset(); auto wrong = request("value", "1"); WebHandlerContext wrongWeb; scalar(wrongWeb, wrong);
            assert(wrongWeb.status == 400 && !pm.submits);
        } else if (mode == "scalar_commands") {
            auto req = request("action", "breathe"); req.add("periodMs", "2000");
            WebHandlerContext web; scalar(web, req);
            assert(web.status == 200 && pm.scalarCommand == ScalarOutputCommand::Breathe && pm.scalarValue == 2000);
            reset(); auto stop = request("action", "stop"); WebHandlerContext stopped; scalar(stopped, stop);
            assert(stopped.status == 200 && pm.scalarCommand == ScalarOutputCommand::Stop && !pm.scalarValue);
            reset(); stop.add("periodMs", "1"); WebHandlerContext mixed; scalar(mixed, stop);
            assert(mixed.status == 400 && !pm.submits);
            reset(); pm.config.type = PeripheralType::DAC; WebHandlerContext noBreathe; scalar(noBreathe, req);
            assert(noBreathe.status == 400 && !pm.submits);
        } else if (mode == "scalar_context") {
            auto req = request("pwm", "12"); WebHandlerContext stale; pm.currentEpoch = 8;
            scalar(stale, req); assert(stale.status == 409 && !pm.begins && !pm.submits);
            reset(); WebHandlerContext noSession; noSession.auth.outputActor = 0;
            scalar(noSession, req); assert(noSession.status == 401 && !pm.submits);
        } else if (mode == "scalar_unknown") {
            pm.accept = false; pm.next.attempted = true; pm.next.reason = "CONTROL_OUTPUT_UNCONFIRMED";
            auto req = request("pwm", "12"); WebHandlerContext web; scalar(web, req);
            assert(web.status == 503 && pm.submits == 1 && pm.finishes == 1);
            JsonDocument doc; assert(!deserializeJson(doc, web.body));
            assert(doc["data"]["control"]["physicalVerified"] == false && doc["data"]["control"]["canConfirmOverride"] == false);
        } else return 2;
        return 0;
    }
    if(mode=="attempt_unknown") {
        JsonDocument doc;OrdinaryControlResult unknown;unknown.evaluated=true;unknown.attemptKnown=false;
        unknown.backendOperationId=42;unknown.acknowledgedSteps=2;unknown.decision=OC::Decision::Conflict;
        unknown.generation=7;unknown.actor={OC::Source::Rule,2};unknown.phase=OC::Phase::Held;
        writeOrdinaryControlJson(doc.to<JsonObject>(),unknown);
        assert(doc["attemptKnown"]==false && doc["attempted"].isNull());
        assert(doc["backendOperationId"]==42 && doc["acknowledgedSteps"]==2 && doc["canConfirmOverride"]==false);
    } else if(mode=="pca_identity") {
        auto req=request("action","pulse");req.add("channel","1");req.add("value","1500");
        WebHandlerContext web;OrdinaryControlContext context;
        assert(beginHttpPcaOutput(web,&req,"relay",7,context));
        assert(pm.begins==1 && !pm.submits && context.request.actor.identity==42 && context.request.holdMs==30000);
        assert(context.request.actor.source==OC::Source::Http && context.configEpoch==7);
    } else if(mode=="pca_fields") {
        for(const char* name:{"actor","source","operation","id","unexpected"}) {
            reset();auto req=request("action","enable");req.add(name,"forged");
            WebHandlerContext web;OrdinaryControlContext context;
            assert(!beginHttpPcaOutput(web,&req,"relay",7,context) && !pm.begins && web.status==400);
        }
        reset();auto req=request("action","enable");req.add("holdMs","1",false);
        WebHandlerContext web;OrdinaryControlContext context;
        assert(!beginHttpPcaOutput(web,&req,"relay",7,context) && !pm.begins);
    } else if(mode=="pca_review") {
        auto req=request("action","enable");req.add("confirmOverride","true");req.add("controlTargetId","relay");
        req.add("controlGeneration","18446744073709551615");req.add("controlConfigEpoch","7");
        WebHandlerContext web;OrdinaryControlContext context;
        assert(beginHttpPcaOutput(web,&req,"relay",7,context) && context.request.reviewedGeneration==UINT64_MAX);
        reset();req.values[3].text="other";WebHandlerContext bad;
        assert(!beginHttpPcaOutput(bad,&req,"relay",7,context) && !pm.begins);
    } else if(mode=="identity") {
        auto req=request();WebHandlerContext web;write(web,req);
        assert(web.status==200 && pm.begins==1 && pm.submits==1 && pm.finishes==1 && !pm.cancelled);
        assert(pm.captured.request.actor.source==OC::Source::Http && pm.captured.request.actor.identity==42);
        assert(pm.captured.request.holdMs==30000 && pm.captured.configEpoch==7 && pm.captured.uartOrigin.unbound());
        for(bool noActor : {false,true}) {reset();WebHandlerContext bad;if(noActor)bad.auth.outputActor=0;else bad.auth.success=false;
            write(bad,req);assert(bad.status==401 && !pm.submits && !pm.begins);}
    } else if(mode=="fields") {
        for(const char* key:{"actor","source","operation","unexpected","id"}) {
            reset();auto req=request();req.add(key,"forged");WebHandlerContext web;write(web,req);
            assert(web.status==400 && !pm.begins && !pm.submits);
        }
        reset();auto query=request();query.add("holdMs","30",false);WebHandlerContext web;write(web,query);assert(web.status==400 && !pm.submits);
    } else if(mode=="state") {
        for(const char* value:{"","-1","2","1.0","true"," 1","1x","999999999999999999999999"}) {
            reset();auto req=request("state",value);WebHandlerContext web;write(web,req);assert(web.status==400 && !pm.submits);
        }
        for(const char* value:{"0","1"}) {reset();auto req=request("state",value);WebHandlerContext web;write(web,req);
            assert(web.status==200 && pm.command==(value[0]=='0'?DigitalOutputCommand::Low:DigitalOutputCommand::High));}
    } else if(mode=="commands") {
        for(const char* action:{"high","low","toggle","stop","blink"}) {reset();auto req=request("action",action);
            if(std::strcmp(action,"blink")==0) { req.add("intervalMs","65535"); }
            WebHandlerContext web;write(web,req);assert(web.status==200 && pm.submits==1);}
        for(const char* value:{"0","65536","1.5","-1",""}) {reset();auto req=request("action","blink");req.add("intervalMs",value);
            WebHandlerContext web;write(web,req);assert(web.status==400 && !pm.submits);}
        reset();auto mixed=request();mixed.add("toggle","true");WebHandlerContext web;write(web,mixed);assert(web.status==400 && !pm.submits);
        reset();auto toggle=request("toggle","false");WebHandlerContext rejected;write(rejected,toggle);assert(rejected.status==400 && !pm.submits);
    } else if(mode=="hold") {
        for(const char* value:{"0","300001","1.1","-1",""," 30","18446744073709551616"}) {reset();auto req=request();req.add("holdMs",value);
            WebHandlerContext web;write(web,req);assert(web.status==400 && !pm.begins);}
        for(const char* value:{"1","300000"}) {reset();auto req=request();req.add("holdMs",value);WebHandlerContext web;write(web,req);
            assert(web.status==200 && pm.captured.request.holdMs==static_cast<uint32_t>(std::stoul(value)));}
    } else if(mode=="confirmation") {
        for(const char* target:{"other",""}) {reset();auto req=request();req.add("confirmOverride","true");req.add("controlTargetId",target);
            req.add("controlGeneration","123");req.add("controlConfigEpoch","7");WebHandlerContext web;write(web,req);assert(web.status==400 && !pm.begins);}
        reset();auto req=request();req.add("controlGeneration","123");WebHandlerContext web;write(web,req);assert(web.status==400 && !pm.begins);
    } else if(mode=="generation") {
        auto req=request();req.add("confirmOverride","true");req.add("controlTargetId","relay");req.add("controlGeneration","18446744073709551615");req.add("controlConfigEpoch","7");
        WebHandlerContext web;pm.next.generation=UINT64_MAX;write(web,req);
        assert(web.status==200 && pm.captured.request.reviewedGeneration==UINT64_MAX);
        JsonDocument doc;assert(!deserializeJson(doc,web.body));assert(std::strcmp(doc["data"]["control"]["generation"],"18446744073709551615")==0);
        reset();req.values[4].text="18446744073709551616";WebHandlerContext bad;write(bad,req);assert(bad.status==400 && !pm.begins);
    } else if(mode=="epoch") {
        auto req=request();WebHandlerContext web;write(web,req,6);assert(web.status==409 && !pm.submits);
        reset();req.add("confirmOverride","true");req.add("controlTargetId","relay");req.add("controlGeneration","2");req.add("controlConfigEpoch","6");
        WebHandlerContext bad;write(bad,req);assert(bad.status==400 && !pm.begins);
    } else if(mode=="conflict") {
        for(auto source:{OC::Source::Rule,OC::Source::Mqtt,OC::Source::Http,OC::Source::Screen}) {
            reset();pm.accept=false;pm.next.actor={source,123};pm.next.phase=OC::Phase::Producing;pm.next.generation=UINT64_MAX-3;
            pm.next.decision=OC::Decision::Conflict;pm.next.reason="CONTROL_CONFLICT";pm.next.holdRemainingMs=5000;
            auto req=request();WebHandlerContext web;write(web,req);assert(web.status==409 && pm.submits==1 && pm.finishes==1);
            JsonDocument doc;assert(!deserializeJson(doc,web.body));assert(doc["data"]["control"]["canConfirmOverride"].as<bool>()==(source==OC::Source::Rule || source==OC::Source::Mqtt));
            assert(doc["data"]["control"]["physicalVerified"]==false);
        }
    } else if(mode=="unknown") {
        pm.accept=false;pm.next.attempted=true;pm.next.reason="CONTROL_OUTPUT_UNCONFIRMED";
        auto req=request("toggle","true");WebHandlerContext web;write(web,req);assert(web.status==503 && pm.submits==1 && pm.finishes==1 && !pm.cancelled);
        JsonDocument doc;assert(!deserializeJson(doc,web.body));assert(doc["data"]["control"]["canConfirmOverride"]==false);
    } else if(mode=="not_attempted") {
        JsonDocument doc;OrdinaryControlResult untried;
        writeOrdinaryControlJson(doc.to<JsonObject>(),untried);
        assert(std::strcmp(doc["reason"],"CONTROL_NOT_ATTEMPTED")==0 && doc["evaluated"]==false);
        untried.evaluated=true;untried.reason="CONTROL_INVALID";untried.operation=UINT64_MAX;
        writeOrdinaryControlJson(doc.to<JsonObject>(),untried);
        assert(std::strcmp(doc["reason"],"CONTROL_INVALID")==0 && doc["evaluated"]==true);
        assert(std::strcmp(doc["operation"],"18446744073709551615")==0);
    } else if(mode=="rule") {
        AsyncWebServerRequest req;req.add("id","some-rule");req.add("value","on");req.add("holdMs","7000");WebHandlerContext web;OrdinaryControlContext context;
        assert(beginHttpRuleOutput(web,&req,7,context));assert(context.request.actor.identity==42 && context.request.holdMs==7000 && !context.request.overrideConfirmed);
        assert(!pm.submits);reset();req.add("confirmOverride","true");WebHandlerContext bad;assert(!beginHttpRuleOutput(bad,&req,7,context));assert(!pm.begins && bad.status==400);
    } else return 2;
}
