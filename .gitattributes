# .gitattributes - Git line ending and encoding configuration
# Prevents automatic conversion issues across different OS platforms

# Force LF line endings for all files (PlatformIO/ESP32 builds require LF)
* text eol=lf

# JavaScript/Node.js files - keep LF
*.js text eol=lf

# Python files - keep LF  
*.py text eol=lf

# PlatformIO config files - critical to use LF
*.ini text eol=lf
*.csv text eol=lf

# Documentation - auto-detect but prefer LF
*.md text eol=lf

# JSON files - preserve exact formatting
*.json text eol=lf

# Exclude binary files from line ending conversion
*.bin binary
*.elf binary
*.axf binary
*.dwarf binary
*.png binary
*.ico binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.bmp binary
*.avif binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.pdf binary
*.gz binary
*.zip binary
