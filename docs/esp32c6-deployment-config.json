{
  "device": {
    "deviceId": "FBE_C6_001",
    "deviceName": "ESP32-C6 OLED 智能显示设备",
    "productNumber": 1,
    "userId": "1",
    "description": "基于 ESP32-C6 的 OLED 显示与 LED 控制设备",
    "location": "实验室 B 区",
    "enableNTP": true,
    "ntpServer1": "http://iot.fastbee.cn/prod-api/iot/tool/ntp",
    "ntpServer2": "cn.pool.ntp.org",
    "timezone": "CST-8",
    "syncInterval": 3600,
    "logLevel": "INFO",
    "developerModeEnabled": true
  },
  "network": {
    "wifiMode": "station",
    "wifiSSID": "your_wifi_ssid",
    "wifiPassword": "your_wifi_password",
    "staticIP": "",
    "staticGateway": "",
    "staticSubnet": "",
    "staticDNS": "",
    "apSSID": "FastBee-C6-001",
    "apPassword": "12345678",
    "hostname": "fastbee-c6-001"
  },
  "mqtt": {
    "server": "iot.fastbee.cn",
    "port": 1883,
    "sslEnabled": false,
    "clientId": "FBE_C6_001",
    "username": "",
    "password": "",
    "keepAlive": 60,
    "cleanSession": true,
    "autoReconnect": true,
    "publishTopic": "fb/iot/FBE_C6_001/data",
    "subscribeTopic": "fb/iot/FBE_C6_001/cmd"
  },
  "peripherals": [
    {
      "id": "oled_display",
      "name": "0.96 英寸 OLED 显示屏",
      "type": "LCD",
      "enabled": true,
      "pinCount": 2,
      "pins": [5, 21],
      "params": {
        "width": 128,
        "height": 64,
        "interface": 2,
        "frequency": 400000,
        "address": 3,
        "contrast": 255
      }
    },
    {
      "id": "led_indicator",
      "name": "RGB LED 指示灯",
      "type": "GPIO_DIGITAL_OUTPUT",
      "enabled": true,
      "pinCount": 1,
      "pins": [19],
      "params": {
        "initialState": 0,
        "passive": false
      }
    }
  ],
  "periph_exec": [
    {
      "id": "oled_system_status",
      "name": "系统状态实时显示",
      "enabled": true,
      "triggerType": "interval",
      "interval": 5000,
      "actions": [
        {
          "type": "updateDisplay",
          "peripheralId": "oled_display",
          "params": {
            "template": "WiFi:Connected|Temp:--°C Time:{time}",
            "formatFunc": "formatSystemStatus"
          }
        }
      ]
    },
    {
      "id": "led_blink_pattern",
      "name": "LED 闪烁模式指示",
      "enabled": true,
      "triggerType": "event",
      "eventPattern": "system_event",
      "actions": [
        {
          "type": "blinkLed",
          "peripheralId": "led_indicator",
          "params": {
            "blinks": 3,
            "interval": 200
          }
        }
      ]
    },
    {
      "id": "periodic_data_upload",
      "name": "周期性数据上报",
      "enabled": true,
      "triggerType": "interval",
      "interval": 60000,
      "actions": [
        {
          "type": "publishData",
          "params": {
            "topic": "fb/iot/FBE_C6_001/data",
            "payloadTemplate": "{\"deviceId\":\"FBE_C6_001\",\"timestamp\":{{timestamp}},\"uptime\":{{uptime}},\"freeHeap\":{{heap}}}"
          }
        }
      ]
    }
  ],
  "protocol": {
    "version": "1.0",
    "dataFormat": "json",
    "compression": false,
    "encryption": false,
    "publishTopics": [
      "fb/iot/FBE_C6_001/data"
    ],
    "subscribeTopics": [
      "fb/iot/FBE_C6_001/cmd"
    ],
    "commands": [
      {
        "name": "led 开关",
        "description": "控制 RGB LED 开关",
        "parameters": [
          {
            "name": "state",
            "type": "integer",
            "required": true,
            "description": "LED 状态：0=关闭，1=开启",
            "enum": [0, 1]
          }
        ]
      },
      {
        "name": "oled_clear",
        "description": "清空 OLED 屏幕",
        "parameters": []
      },
      {
        "name": "oled_text",
        "description": "在 OLED 上显示文本",
        "parameters": [
          {
            "name": "text",
            "type": "string",
            "required": true,
            "description": "要显示的文本内容"
          },
          {
            "name": "x",
            "type": "integer",
            "required": false,
            "description": "X 坐标",
            "default": 0
          },
          {
            "name": "y",
            "type": "integer",
            "required": false,
            "description": "Y 坐标",
            "default": 0
          }
        ]
      }
    ]
  }
}
